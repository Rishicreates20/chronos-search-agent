# Copy to .env and fill in the two keys.

# LLM key. Default provider is Gemini 2.5 Flash (https://aistudio.google.com/apikey).
LLM_API_KEY=

# Web search key (https://app.tavily.com).
TAVILY_API_KEY=

# --- Optional ---------------------------------------------------------------
# LLM_PROVIDER=gemini            # gemini | groq | openai; put that provider's key in LLM_API_KEY
#                                # (groq => llama-3.3-70b-versatile, openai => gpt-4o-mini)
# LLM_MODEL=gemini-2.5-flash     # override the provider's default model
# LLM_BASE_URL=                  # any OpenAI-compatible /chat/completions base URL
# LLM_REASONING_EFFORT=none      # sent as-is when non-empty; "none" turns Gemini thinking off
# HISTORY_TURNS=10               # sliding window: last N turns sent to the model
# SEARCH_TIMEOUT_S=3             # abort a web search after this many seconds
# DB_PATH=data/chronos.db
# PORT=8000

# --- Optional: durable memory on a serverless host ---------------------------
# Leave these unset to use the local SQLite file. Set all three to store
# memory in Supabase Postgres instead (apply supabase/schema.sql first).
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_KEY=                  # the project's publishable key
# MEMORY_TOKEN=                  # secret whose SHA-256 is in chronos.settings
