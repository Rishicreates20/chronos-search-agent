# Copy to .env and fill in the two keys. These are the only keys the agent needs.

# LLM key. The default provider is Groq (free tier: https://console.groq.com/keys).
LLM_API_KEY=

# Web search key (free tier: https://app.tavily.com).
TAVILY_API_KEY=

# --- Optional ---------------------------------------------------------------
# LLM_PROVIDER=groq              # groq | openai | gemini; put that provider's key in LLM_API_KEY
#                                # (groq => openai/gpt-oss-120b, openai => gpt-4o-mini, gemini => gemini-2.5-flash)
# LLM_MODEL=                     # override the provider's default model (GET /api/models lists valid ids)
# LLM_BASE_URL=                  # any OpenAI-compatible /chat/completions base URL
# LLM_REASONING_EFFORT=low       # sent as-is when non-empty; dropped automatically if the provider rejects it
# SEARCH_DEPTH=fast              # Tavily depth: ultra-fast | fast | basic (falls back to basic if rejected)
# SEARCH_TIMEOUT_S=4             # abort a web search after this many seconds
# HISTORY_TURNS=10               # sliding window: last N turns sent to the model
# DB_PATH=data/chronos.db
# PORT=3000

# --- Optional: durable memory on a serverless host ---------------------------
# Leave unset to use the local SQLite file. Set all three to store memory in
# Supabase Postgres instead (run supabase/schema.sql there first). SUPABASE_KEY
# is the project's publishable key; MEMORY_TOKEN is a secret you choose.
# SUPABASE_URL=
# SUPABASE_KEY=
# MEMORY_TOKEN=
